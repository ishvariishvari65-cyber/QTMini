<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="QT Mini 💖"
            android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/btnMenu" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="⚙" />
    </LinearLayout>

    <ListView
        android:id="@+id/chatList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:transcriptMode="alwaysScroll"
        android:stackFromBottom="true" android:divider="@null" android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="6dp">
        <Button android:id="@+id/btnMic" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="🎤" />
        <EditText android:id="@+id/input" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="QT se kuch bolo..." android:inputType="textMultiLine"
            android:maxLines="4" />
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="➤" />
    </LinearLayout>
</LinearLayout>
